# ==============================================================================
# PULSECHAT FRONTEND ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# Application Branding
VITE_APP_NAME=PulseChat

# Backend Server URL (Used for REST API calls and Socket.IO real-time connection)
# Use 127.0.0.1 on Windows to prevent IPv6/IPv4 ECONNRESET issues
VITE_SERVER_URL=http://127.0.0.1:5000
