# ==============================================================================
# PULSECHAT BACKEND ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and fill in your values
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication / Security
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ==============================================================================
# DATABASE CONFIGURATION (MongoDB)
# ==============================================================================
# Primary Database Connection:
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/pulsechat
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/pulsechat?retryWrites=true&w=majority

# Category-Based Multi-Database Separation (Optional):
# Uncomment to store data across separate physical databases
# MONGODB_URI_AUTH=mongodb://127.0.0.1:27017/pulsechat_auth
# MONGODB_URI_MESSAGES=mongodb://127.0.0.1:27017/pulsechat_messages
# MONGODB_URI_STATUS=mongodb://127.0.0.1:27017/pulsechat_status
# MONGODB_URI_LOGS=mongodb://127.0.0.1:27017/pulsechat_logs

# ==============================================================================
# EMAIL SERVICE CONFIGURATION (Nodemailer / SMTP)
# ==============================================================================
# SMTP credentials for sending verification emails, password resets, and account deletion notices.
# If omitted, emails are printed directly to the server terminal console in development mode.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
EMAIL_FROM="PulseChat Support" <noreply@pulsechat.io>

# ==============================================================================
# CLOUD MEDIA STORAGE (Cloudinary)
# ==============================================================================
# For cloud media hosting (voice messages, avatars, images).
# If omitted, media falls back to local disk storage in server/uploads/.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Alternatively:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
